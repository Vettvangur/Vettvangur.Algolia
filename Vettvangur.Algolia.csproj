<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<UmbracoNet10Version Condition="'$(UmbracoNet10Version)' == ''">17.6.2</UmbracoNet10Version>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- NuGet metadata -->
		<PackageId>Vettvangur.Algolia</PackageId>
		<Title>Vettvangur.Algolia</Title>
		<Description>Umbraco → Algolia indexer with per-culture indexes, background queue/worker, and coalesced updates.</Description>
		<Version>1.12.0</Version>
		<Authors>Vettvangur</Authors>
		<PackageTags>umbraco;plugin;package;algolia;indexer;search</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/Vettvangur/Vettvangur.Algolia</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Vettvangur/Vettvangur.Algolia</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReleaseNotes/>
		<Copyright>Copyright © 2025 Vettvangur</Copyright>

		<!-- Icon & README -->
		<PackageIcon>vv_logo.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<!-- Symbols & SourceLink -->
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>

		<!-- Build / docs -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

		<!-- Optional QoL -->
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<!-- <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild> -->
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Algolia.Search" Version="7.40.0"/>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All"/>
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Umbraco.Cms.Core" Version="13.13.0"/>
		<PackageReference Include="Umbraco.Cms.Web.BackOffice" Version="13.13.0"/>
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Umbraco.Cms.Api.Management" Version="$(UmbracoNet10Version)"/>
		<PackageReference Include="Umbraco.Cms.Core" Version="$(UmbracoNet10Version)"/>
		<PackageReference Include="Umbraco.Cms.Web.Common" Version="$(UmbracoNet10Version)"/>
	</ItemGroup>

	<!-- Pack the icon & README into the nupkg -->
	<ItemGroup>
		<None Include="vv_logo.png" Pack="true" PackagePath=""/>
		<None Include="README.md" Pack="true" PackagePath=""/>
		<None Include="CHANGELOG.md" Pack="true" PackagePath=""/>
	</ItemGroup>

</Project>
